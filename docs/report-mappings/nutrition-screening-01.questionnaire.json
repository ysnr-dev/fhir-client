  "description": "入院時の栄養スクリーニングとアセスメント。入院基本料の栄養管理体制の要件(入院時に栄養状態を確認し、特別な栄養管理が必要な患者に栄養管理計画を作る)に沿う。MUST でリスクを、GLIM 基準で低栄養の有無を、SGA で栄養状態を評価し、特別な栄養管理の必要性を判定する。必要性が有の入院は入退院文書で栄養管理計画書の対象になる。回答から Observation を生成する(MUST の合計・SGA・必要性)。",
  "extension": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "(descendants().where(linkId = 'weight').answer.value.first() / ((descendants().where(linkId = 'height').answer.value.first() / 100) * (descendants().where(linkId = 'height').answer.value.first() / 100))).round(1)",
        "name": "nutBmi"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "((descendants().where(linkId = 'usual_weight').answer.value.first() - descendants().where(linkId = 'weight').answer.value.first()) / descendants().where(linkId = 'usual_weight').answer.value.first() * 100).round(1)",
        "name": "nutLossRate"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "iif(%nutBmi.exists(), iif(%nutBmi < 18.5, 2, iif(%nutBmi <= 20, 1, 0)), {})",
        "name": "nutMustBmi"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "iif(%nutLossRate.exists(), iif(%nutLossRate > 10, 2, iif(%nutLossRate >= 5, 1, 0)), 0)",
        "name": "nutMustLoss"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "iif(%nutMustBmi.exists(), %nutMustBmi + %nutMustLoss + descendants().where(linkId = 'must_acute').answer.value.select(code.toInteger()).sum(), {})",
        "name": "nutMust"
      }
    },
