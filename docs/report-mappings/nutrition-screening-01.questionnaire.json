            {
              "valueCoding": {
                "code": "0",
                "display": "なし"
              }
            },
            {
              "valueCoding": {
                "code": "2",
                "display": "あり"
              }
            }
          ]
        },
        {
          "linkId": "must_total",
          "type": "integer",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
              "valueCoding": {
                "system": "http://unitsofmeasure.org",
                "code": "点",
                "display": "点"
              }
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%nutMust"
              }
            }
          ],
          "code": [
            {
              "system": "http://fhir-client.local/CodeSystem/observation-item",
              "code": "NUT-MUST-SCORE",
              "display": "MUST の合計"
            }
          ],
          "text": "合計"
        },
        {
          "linkId": "must_risk",
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%nutMust.exists(), iif(%nutMust >= 2, '高', iif(%nutMust = 1, '中', '低')), {})"
              }
            }
          ],
          "text": "栄養リスク"
