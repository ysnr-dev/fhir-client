  "name": "END_EGD_01",
  "title": "上部内視鏡 前処置・鎮静指示",
  "status": "active",
  "subjectType": [
    "Patient"
  ],
  "description": "内視鏡オーダー(上部)の「特別指示」に貼るテンプレート。検査室が前処置・鎮静の準備をするために毎回確認する内容だけを並べる。選択肢のうち JED 用語集[基本情報]に対応する項目(挿入経路・鎮静)は JED の統一表記をそのまま転記してある。記入しなかった項目は特別指示の文面に出ないので、当てはまるものだけ埋めればよい。",
  "extension": [
    {
      "url": "http://fhir-client.local/StructureDefinition/questionnaire-template-category",
      "valueCoding": {
        "system": "http://fhir-client.local/CodeSystem/questionnaire-template-category",
        "code": "25675b10-0ef3-4425-83c4-c1f8c3015cca",
        "display": "検査"
      }
    }
  ],
  "item": [
    {
      "linkId": "grp-prep",
      "type": "group",
      "text": "前処置・患者準備",
      "item": [
        {
          "linkId": "prep-fasting",
          "type": "choice",
          "text": "絶食指示",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/CodeSystem/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "外来は前日夕食後から絶食が既定。入院や午後枠で異なるときだけ開始も書く。"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "instructed",
                "display": "指示済"
              }
            },
            {
              "valueCoding": {
                "code": "not-yet",
                "display": "未指示"
              }
            }
          ],
          "item": [
            {
              "linkId": "grp-fasting",
              "type": "group",
              "text": "絶食",
              "enableWhen": [
                {
                  "question": "prep-fasting",
                  "operator": "=",
                  "answerCoding": {
                    "code": "instructed"
                  }
                }
              ],
              "item": [
                {
                  "linkId": "prep-fasting-from",
                  "type": "string",
                  "text": "絶食の開始",
                  "extension": [
                    {
                      "url": "http://hl7.org/fhir/StructureDefinition/designNote",
                      "valueMarkdown": "例: 前日21時から、当日6時間前から。"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "linkId": "prep-route",
          "type": "choice",
          "text": "挿入経路の希望",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
