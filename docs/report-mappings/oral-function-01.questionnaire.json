    {
      "linkId": "hypo_count",
      "type": "integer",
      "text": "該当項目数",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
          "valueCoding": {
            "system": "http://unitsofmeasure.org",
            "code": "項目",
            "display": "項目"
          }
        },
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "iif(descendants().where(linkId='tci').answer.value.first() >= 50, 1, 0) + iif(descendants().where(linkId='mucosal_moisture').answer.value.first() < 27, 1, 0) + iif((descendants().where(linkId='bite_force').answer.value.first() < 500) or (descendants().where(linkId='remaining_teeth').answer.value.first() < 20), 1, 0) + iif((descendants().where(linkId='odk_pa').answer.value.first() < 6) or (descendants().where(linkId='odk_ta').answer.value.first() < 6) or (descendants().where(linkId='odk_ka').answer.value.first() < 6), 1, 0) + iif(descendants().where(linkId='tongue_pressure').answer.value.first() < 30, 1, 0) + iif(descendants().where(linkId='glucose_elution').answer.value.first() < 100, 1, 0) + iif(descendants().where(linkId='eat10').answer.value.first() >= 3, 1, 0)"
          }
        }
      ],
      "code": [
        {
          "system": "http://fhir-client.local/CodeSystem/observation-item",
          "code": "DENT-ORAL-HYPO-COUNT",
          "display": "口腔機能低下症の該当項目数"
        }
      ]
