  "description": "看護プロファイルの区画「転倒・転落リスク」。自作の簡易スコア(合計 0〜14 点。0〜3 点 I・4〜7 点 II・8 点以上 III)。施設の評価票に合わせて項目・配点を直して使う想定。選択肢のコードは点数そのもの。回答から Observation を生成する(合計と危険度)。",
  "extension": [
    {
      "url": "http://fhir-client.local/StructureDefinition/questionnaire-template-category",
      "valueCoding": {
        "system": "http://fhir-client.local/CodeSystem/questionnaire-template-category",
        "code": "d2a7c5e1-3b84-4f6a-9e10-7c4b2a8f5e36",
        "display": "看護プロファイル"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "fallScore",
        "language": "text/fhirpath",
        "expression": "descendants().where(linkId.startsWith('fr_') and linkId != 'fr_total' and linkId != 'fr_level').answer.value.select(code.toInteger()).sum()"
      }
    },
    {
