{
  "resourceType": "Questionnaire",
  "meta": {
    "profile": [
      "http://www.hosp.ncgm.go.jp/JASPEHR/fhir/StructureDefinition/jaspehr-questionnaire"
    ]
  },
  "url": "http://fhir-client.local/Questionnaire/idsc-notify-01",
  "version": "1.0.0",
  "name": "IDSC_NOTIFY_01",
  "title": "感染症 発生届(共通項目)",
  "status": "active",
  "subjectType": [
    "Patient"
  ],
  "description": "感染症法 第 12 条の発生届(全数把握の感染症)の共通項目。届出対象の病名を対象プロブレムに選んで記入する。感染症名・類型・診断日・患者の氏名などは診療記録から初期値が入る。感染症ごとの届出様式(別記様式)の固有項目は「症状」「診断方法」「その他」に書く。五類の一部(梅毒・後天性免疫不全症候群など)は氏名・住所を届け出ないので、その欄は空のままにする。届出状況を「届出済」にすると発生届の一覧で届出済になる。",
  "extension": [
    {
      "url": "http://fhir-client.local/StructureDefinition/questionnaire-template-category",
      "valueCoding": {
        "system": "http://fhir-client.local/CodeSystem/questionnaire-template-category",
        "code": "25675b10-0ef3-4425-83c4-c1f8c3015cca",
        "display": "検査"
      }
    }
  ],
  "item": [
    {
      "linkId": "grp-disease",
      "type": "group",
      "text": "感染症",
      "item": [
        {
          "linkId": "idn_disease",
          "type": "string",
          "text": "感染症名",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%notifiableDiseaseName"
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "届出基準の感染症名。対象プロブレムが届出対象なら自動で入る。"
            }
          ],
          "required": true
        },
        {
          "linkId": "idn_class",
          "type": "string",
          "text": "類型",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%notifiableDiseaseClass"
              }
            }
          ]
        },
        {
          "linkId": "idn_kind",
          "type": "choice",
          "text": "届出の区分",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/CodeSystem/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            }
          ],
          "required": true,
          "answerOption": [
            {
              "valueCoding": {
                "code": "patient",
                "display": "患者"
              }
            },
            {
              "valueCoding": {
                "code": "carrier",
                "display": "無症状病原体保有者"
              }
            },
            {
              "valueCoding": {
                "code": "suspected",
                "display": "疑似症患者"
              }
            },
            {
              "valueCoding": {
                "code": "death",
                "display": "感染症死亡者の死体"
              }
            },
            {
              "valueCoding": {
                "code": "death-suspected",
                "display": "感染症死亡疑い者の死体"
              }
            }
          ]
        },
        {
          "linkId": "idn_due",
          "type": "date",
          "text": "届出期限",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%notifiableDueDate"
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "一類〜四類・新型インフルエンザ等は直ちに(診断日)、五類は診断から 7 日以内(麻しん・風しん・侵襲性髄膜炎菌感染症は直ちに)。"
            }
          ]
        }
      ]
    },
    {
      "linkId": "grp-patient",
      "type": "group",
      "text": "患者",
      "item": [
        {
          "linkId": "idn_name",
          "type": "string",
          "text": "氏名",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.name.where(extension.where(value = 'SYL').empty()).select(family + '　' + given.first()).first()"
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "五類の一部(梅毒・後天性免疫不全症候群・ウイルス性肝炎など)は氏名を届け出ない。該当するときは空にする。"
            }
          ]
        },
        {
          "linkId": "idn_sex",
          "type": "choice",
          "text": "性別",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/CodeSystem/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%patient.gender='male','male',iif(%patient.gender='female','female',{}))"
              }
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "male",
                "display": "男"
              }
            },
            {
              "valueCoding": {
                "code": "female",
                "display": "女"
              }
            }
          ]
        },
        {
          "linkId": "idn_birth",
          "type": "date",
          "text": "生年月日",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.birthDate"
              }
            }
          ]
        },
        {
          "linkId": "idn_age",
          "type": "integer",
          "text": "年齢",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%age"
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/minValue",
              "valueInteger": 0
            }
          ]
        },
        {
          "linkId": "idn_address",
          "type": "string",
          "text": "住所",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.address.first().text"
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "氏名を届け出ない感染症は都道府県・市区町村まで。"
            }
          ]
        },
        {
          "linkId": "idn_phone",
          "type": "string",
          "text": "電話番号",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.telecom.where(system = 'phone').value.first()"
              }
            }
          ]
        },
        {
          "linkId": "idn_occupation",
          "type": "string",
          "text": "職業"
        }
      ]
