  "version": "1.0.0",
  "name": "RAD_CT_01",
  "title": "CT検査 特別指示",
  "status": "active",
  "subjectType": ["Patient"],
  "description": "放射線オーダー(CT)の「特別指示」に貼るテンプレート。撮影する側が動くために必要な指示だけを並べる。撮影項目そのもの(モダリティ・部位・体位・方向)は項目マスタの JJ1017 コードが持つので、ここには書かない。記入しなかった項目は特別指示の文面に出ないので、当てはまるものだけ埋めればよい。",
  "extension": [
    {
      "url": "http://fhir-client.local/StructureDefinition/questionnaire-template-category",
      "valueCoding": {
        "system": "http://fhir-client.local/CodeSystem/questionnaire-template-category",
        "code": "25675b10-0ef3-4425-83c4-c1f8c3015cca",
        "display": "検査"
      }
    }
  ],
  "item": [
    {
      "linkId": "grp-scope",
      "type": "group",
      "text": "撮影範囲・撮影条件",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/designNote",
          "valueMarkdown": "撮影項目(JJ1017)で決まっている範囲・条件をなぞる必要はない。項目名だけでは伝わらない範囲の指定と、この依頼に限った条件だけを書く。"
        }
      ],
      "item": [
        {
          "linkId": "scope-from",
          "type": "string",
          "text": "撮影範囲(開始)",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "ランドマークで書く(例: 肺尖、頭頂)。部位コードは1部位しか持てないため、連続撮影の範囲はここで示す。"
            }
          ]
        },
        {
          "linkId": "scope-to",
          "type": "string",
          "text": "撮影範囲(終了)",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "ランドマークで書く(例: 腸骨稜、膝関節上縁)。"
            }
          ]
        },
        {
          "linkId": "scope-recon",
          "type": "choice",
          "text": "追加の再構成・後処理",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/CodeSystem/questionnaire-item-control",
                    "code": "check-box"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "撮影項目の特殊指示(JJ1017 別表6B)に含まれている後処理は項目側で伝わる。ここは項目に無いものを追加で頼むときに使う。"
            }
          ],
          "answerOption": [
            { "valueCoding": { "code": "thin", "display": "薄層再構成" } },
            { "valueCoding": { "code": "mpr", "display": "MPR作成" } },
            { "valueCoding": { "code": "3d", "display": "3D作成" } },
            { "valueCoding": { "code": "mip", "display": "MIP作成" } },
            { "valueCoding": { "code": "minip", "display": "MinIP作成" } },
            { "valueCoding": { "code": "bone", "display": "骨条件で作成" } },
            { "valueCoding": { "code": "lung", "display": "肺野条件で作成" } }
          ]
        },
        {
          "linkId": "scope-condition",
          "type": "string",
          "text": "スライス厚・撮影条件の指定",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "例: 1mm スライスで再構成、低線量プロトコルで、前回と同じ条件で。"
            }
          ]
        },
        {
          "linkId": "scope-device",
          "type": "string",
          "text": "装置・撮影室の指定",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "装置を選ぶ理由がある場合だけ(例: 冠動脈のため320列で、寝台耐荷重の都合)。"
            }
          ]
        }
      ]
