  "version": "1.0.0",
  "name": "PU_DESIGNR_01",
  "title": "褥瘡 DESIGN-R評価",
  "status": "active",
  "subjectType": [
    "Patient"
  ],
  "description": "褥瘡の創 1 つにつき 1 回答で、評価のたびに新しい回答を書く(前回値複写が使える)。DESIGN-R 2020 の 7 項目(選択肢のコードは記号そのもの)と合計(深さを含めない 0〜66 点)・重症度(大文字の項目が 1 つでもあれば重症)を持ち、回答から Observation を生成する。褥瘡管理(/pressure-ulcer)の保有患者と発生率は、部位・発生区分・発生日・状態から数える。",
  "extension": [
    {
      "url": "http://fhir-client.local/StructureDefinition/questionnaire-template-category",
      "valueCoding": {
        "system": "http://fhir-client.local/CodeSystem/questionnaire-template-category",
        "code": "3f0c9a52-7d61-4b8e-9a2c-5e1b7c4d8f02",
        "display": "褥瘡"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "designrTotal",
        "language": "text/fhirpath",
        "expression": "descendants().where(linkId = 'designr_e' or linkId = 'designr_s' or linkId = 'designr_i' or linkId = 'designr_g' or linkId = 'designr_n' or linkId = 'designr_p').answer.value.select(code.replaceMatches('[^0-9]', '').toInteger()).sum()"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "designrSevere",
        "language": "text/fhirpath",
        "expression": "descendants().where(linkId.startsWith('designr_')).answer.value.select(code).where($this.matches('^[A-Z]')).exists()"
      }
    },
