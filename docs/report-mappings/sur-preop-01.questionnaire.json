    {
      "item": [
        {
          "text": "固形物",
          "type": "choice",
          "linkId": "fast-solid",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "固形物の絶食。当日の手術開始が遅い枠でも一律に「前日夕食後」にすると脱水と低血糖を招くので、開始時刻に合わせて選ぶ。"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "code": "radio-button",
                    "system": "http://hl7.org/fhir/CodeSystem/questionnaire-item-control"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "none",
                "display": "制限なし"
              }
            },
            {
              "valueCoding": {
                "code": "after-dinner",
                "display": "前日夕食後から絶食"
              }
            },
            {
              "valueCoding": {
                "code": "from-midnight",
                "display": "前日24時から絶食"
              }
            },
            {
              "valueCoding": {
                "code": "morning",
                "display": "当日朝食から絶食"
              }
            }
          ]
        },
        {
          "text": "絶食の開始時刻",
          "type": "string",
          "linkId": "fast-solid-at",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "選択肢だけでは時刻が決まらないときに書く(例: 前日21:00)。病棟が下膳の時刻を決められる形で。選択肢で足りるなら空欄でよい。"
            }
          ]
        },
        {
          "text": "水分(清澄水)",
          "type": "choice",
          "linkId": "fast-clear",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "清澄水(水・茶・経口補水液)は誤嚥のリスクを上げないため、麻酔科学会のガイドラインでは麻酔導入2時間前まで許容される。「禁止」にするのは腸閉塞・胃排出遅延など理由のあるときだけ。"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "code": "radio-button",
                    "system": "http://hl7.org/fhir/CodeSystem/questionnaire-item-control"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "until-2h",
                "display": "手術2時間前まで可"
              }
            },
            {
              "valueCoding": {
                "code": "until-3h",
                "display": "手術3時間前まで可"
              }
            },
            {
              "valueCoding": {
                "code": "from-midnight",
                "display": "前日24時から禁止"
              }
            },
            {
              "valueCoding": {
                "code": "prohibited",
                "display": "禁止"
              }
            }
          ]
        },
        {
          "text": "経口補水液の指示",
          "type": "string",
          "linkId": "fast-ors",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "銘柄と量・飲み終える時刻(例: OS-1 500mL を手術2時間前までに)。"
            }
          ]
        }
      ],
      "text": "絶飲食",
      "type": "group",
      "linkId": "grp-fasting"
    },
