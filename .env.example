# docker compose がプロジェクト直下の .env を読んで展開する。
# cp .env.example .env して値を入れる(.env は git 管理外)。

# 院内エージェント(profile agent)がカルテへ通知を投げるときの Bearer トークン。
# 管理 > 外部システム連携 > 接続設定 で発行する。未設定だとエージェントは起動しない。
RECEIPT_INBOUND_TOKEN=

# 日レセ(profile orca)の ormaster パスワード(8〜16文字)。
# 空ボリュームからの初回起動時にだけ設定される。
ORMASTER_PASSWORD=weborcadev1
